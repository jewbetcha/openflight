	(footprint "ADF4159_LFCSP24"
		(layer "F.Cu")
		(uuid "0ca911d7-2154-4015-972a-cf5289e5c428")
		(at 45.5 30 180)
		(descr "ADF4159, 24-lead LFCSP_WQ 4x4mm (CP-24-10), 0.5mm pitch, EP 2.10mm sq, EP=AGND (datasheets/extracted/adf4159.md Fig.56 p.36 + explicit ADI PCB Design Guideline p.34: land 0.1mm longer / 0.05mm wider than package lead; thermal via grid 1.2mm pitch, drill 0.30-0.33mm, 1oz Cu barrel plating). This is the authoritative ADI-recommended land rule (not extrapolated) that ADF5901/ADF5904 land patterns above were extrapolated FROM, per Task 3 disclosure. Land length=0.40mm lead+0.10mm=0.50mm; land width capped at AN-772 X_MAX=0.28mm/0.5mm pitch (cross-checked, consistent with datasheet's own 0.05mm-wider rule -> 0.30mm, AN-772 caps tighter at 0.28mm to avoid bridging, more conservative value used). Thermal via grid 2x2 @1.2mm pitch, 0.3mm drill/0.6mm pad (mid-range of ADI's 0.30-0.33mm spec). EP paste windowed 4-quadrant, 70% coverage.")
		(tags "ADF4159 LFCSP24 PLL synthesizer")
