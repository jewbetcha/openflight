	(text "POWER ENTRY + REGULATOR SET (Task 11)\\n+5V from interface header J1 pins 1/2; GND pins 3/4.\\nInput protection: D1 Schottky (reverse) + FB1 ferrite (per EV-RADAR-MMIC2 Fig.14).\\nU1 ADP7104-3.3 -> +3V3_TX (ADF5901).  U2 ADP7104-3.3 -> +3V3_RX (ADF5904 + ADF4159 analog).\\nU3 ADP150-1.8 -> +1V8_DIG (ADF4159 digital/SDVDD).\\nADF4159 analog folded onto +3V3_RX per Task-11 amendment (drops ref board separate ADP150-3.0)."
		(exclude_from_sim no)
		(at 190.5 20.32 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "0f000000-0000-4000-8000-0000000000a0")
	)
	(text "RESERVED FOR HIERARCHICAL SHEETS (Tasks 12-15)\\n[ PLL sheet ]  [ TX sheet ]  [ RX sheet ]  [ IO sheet ]\\nRails (+5V/+3V3_TX/+3V3_RX/+1V8_DIG/GND) propagate as global power symbols;\\nsignals cross via hierarchical pins added by those tasks."
		(exclude_from_sim no)
		(at 190.5 165.1 0)
		(effects (font (size 1.27 1.27)) (justify left top))
		(uuid "0f000000-0000-4000-8000-0000000000a1")
	)

