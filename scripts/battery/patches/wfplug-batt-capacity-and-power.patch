+gint power_supply_on_external_power(void)
+{
+    const gchar *entry;
+    gboolean found = FALSE;
+    GDir *dir = g_dir_open(ACPI_PATH_SYS_POWER_SUPPLY, 0, NULL);
+
+    if (dir == NULL)
+        return -1;
+
+    while ((entry = g_dir_read_name(dir)) != NULL)
+    {
+        battery supply = {0};
+        gchar *type;
+        gboolean is_battery;
+        supply.path = (gchar *) entry;
+        type = get_gchar_from_infofile(&supply, "type");
+        is_battery = type != NULL && g_ascii_strcasecmp(type, "Battery") == 0;
+        g_free(type);
+        if (is_battery)
+            continue;
+        gint online = get_raw_gint_from_infofile(&supply, "online");
+
+        if (online < 0)
+            continue;
+        found = TRUE;
+        if (online > 0)
+        {
+            g_dir_close(dir);
+            return 1;
+        }
+    }
+
+    g_dir_close(dir);
+    return found ? 0 : -1;
+}
